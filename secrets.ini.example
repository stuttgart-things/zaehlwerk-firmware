; Template for secrets.ini. `task setup` writes one interactively; by hand:
;
;     cp secrets.ini.example secrets.ini
;
; secrets.ini is in .gitignore and does not belong in the repository. Without the
; file the project still builds and takes the defaults from include/config.h.

[secrets]
; The password for updating over the air — for espota and for the upload in the
; web UI. Leaving it empty means OTA stays off, and the firmware says so at
; startup. The firmware gets the value as a build flag and platformio.ini as
; --auth, both from this one line.
;
; Note that espota prints it in the clear on every upload; treat it as visible
; to anyone who can read your terminal.
ota_pass = bitte-aendern

build_flags =
    ; Password of the access point the ESP32 carries. "pingpong" is the value
    ; printed in docs/piezo-stufe-1-2.md, so it is public already and no
    ; secret. Change it for a table in an office.
    -DZW_AP_PASS='"pingpong"'

    ; The wifi the ESP32 joins. This only seeds the first connection: once
    ; credentials are stored through the web UI they win, and clearing NVS falls
    ; back to this again. Leave both empty to have the board carry only its own
    ; access point.
    -DZW_STA_SSID='"mein-wlan"'
    -DZW_STA_PASS='"mein-wlan-passwort"'

    ; zaehlwerk-api, where points are reported (ADR-0008). Optional: without
    ; it the board counts on its own, as before, and a fob is answered
    ; "unavailable" (#63). Like the wifi above this only seeds the board while
    ; NVS holds no address; once one is set or cleared on the board's page,
    ; that wins. https:// for zaehlwerk behind the Gateway
    ; (verified against the edge root only), http:// for a laptop. An IP or a
    ; DNS name, not .local.
    ; -DZW_API_URL='"https://zaehlwerk.edge.sthings.lab"'

    ; The board's name in the ingest contract. Two boards need two names.
    ; -DZW_INGEST_SOURCE='"piezo-tisch-1"'

    ; zaehlwerk's CHECKIN_TOKEN, sent as a bearer with every check-in (#65).
    ; Without one no check-in is sent. Like the wifi above, this only seeds the
    ; board while NVS holds none: once a token is set or cleared on the board's
    ; page, that wins. A released image is given its token on the page.
    ; Printable ASCII, no spaces, at most 256 characters.
    ; -DZW_CHECKIN_TOKEN='"the-same-value-as-on-zaehlwerk"'
