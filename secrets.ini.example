; Vorlage für secrets.ini — einmal kopieren und ausfüllen:
;
;     cp secrets.ini.example secrets.ini
;
; secrets.ini ist in .gitignore und gehört nicht ins Repo. Fehlt die Datei,
; baut das Projekt trotzdem und nimmt die Vorgaben aus include/config.h.

[secrets]
; Passwort für das Einspielen per OTA — für espota und für den Upload in der
; Web-UI. Leer lassen heißt: OTA bleibt aus, und die Firmware sagt das beim
; Start. Die Firmware bekommt den Wert als Build-Flag, platformio.ini als
; --auth; beides aus dieser einen Zeile.
ota_pass = bitte-aendern

build_flags =
    ; Passwort des eigenen Accesspoints, den der ESP32 aufspannt.
    ; "pingpong" ist der Wert, der in docs/piezo-stufe-1-2.md steht — also
    ; ohnehin öffentlich und kein Geheimnis. Für die Platte im Büro ändern.
    -DZW_AP_PASS='"pingpong"'

    ; WLAN, in das sich der ESP32 einbucht. Noch ungenutzt — der Stufe-2-Stand
    ; kennt nur den eigenen Accesspoint; der STA-Modus kommt mit Abschnitt 2.
    -DZW_STA_SSID='"mein-wlan"'
    -DZW_STA_PASS='"mein-wlan-passwort"'
